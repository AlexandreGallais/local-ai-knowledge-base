{
  // Test project WITHOUT the base: the same image, the same OpenCode, the same model and the same web
  // lock as the project with the base, and nothing else. See guides/compare-with-and-without.md.
  "name": "without-base",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",
  "mounts": [
    // Your own OpenCode configuration (the model): the same folder for both test projects.
    "type=bind,source=${localWorkspaceFolder}/../opencode-user,target=/home/node/.config/opencode"
  ],
  // The keys of the model, such as ANTHROPIC_API_KEY, read from ai.env beside the two projects: one
  // file for both, outside every Git repository.
  "runArgs": ["--env-file", "${localWorkspaceFolder}/../ai.env"],
  "remoteEnv": {
    // The web lock of this container, above the user and project configs of OpenCode: no web search
    // tool, no web fetch, no download, no shared session. The same text in both containers.
    "OPENCODE_CONFIG_CONTENT": "{\"websearch\":false,\"share\":\"disabled\",\"policies\":[{\"action\":\"websearch.use\",\"resource\":\"*\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"webfetch:*\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"websearch:*\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"shell:curl *\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"shell:wget *\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"shell:git clone *\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"shell:git fetch *\",\"effect\":\"deny\"},{\"action\":\"tool.use\",\"resource\":\"shell:git pull *\",\"effect\":\"deny\"}]}"
  },
  // Once, when the container is created: OpenCode 2.2.7 installed in the project (npx opencode or npm
  // run opencode), its postinstall run by hand as npm 12 blocks it, node_modules kept out of Git.
  "postCreateCommand": "[ -f package.json ] || printf '{\\n  \"private\": true\\n}\\n' > package.json; [ -f .gitignore ] || printf 'node_modules/\\n' > .gitignore; npm install --save-dev --save-exact --no-audit --no-fund @opencode/cli@2.2.7 && node node_modules/@opencode/cli/postinstall.mjs && npm pkg set scripts.opencode=opencode"
}
