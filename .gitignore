# Dependencies and builds
node_modules/
dist/
.angular/

# The lock file npm writes when the example project is installed: each project keeps its own.
/project/package-lock.json

# Clones of the documentation sources, made by the build tools when they fetch the documentation
.library-cache/

# Search indexes of the documentation bricks: built on each machine by their build-index.ts
/project/.agents/mcp/*/index/

# Research reports dropped at the root before they are moved to research/: never in Git
/t[0-9]*-*/

# Local secrets
.env
.env.*

# The system's
.DS_Store
