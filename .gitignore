# Dependencies and builds
node_modules/
dist/
bin/
obj/
target/

# Extracts of heavy files, written by the read-heavy-file skill
.extract/

# Clones of the documentation sources, made by scripts/fetch-library.ts
.library-cache/

# Research reports dropped at the root before they are moved to research/: never in Git
/t[0-9]*-*/

# Local state of the chat adapter. The export/ folder is kept: it holds the export of the last
# delivery, built by scripts/export.ts --trial.
state.local.json

# Measures of an evaluation on the workstation, and its run folders
**/evaluation/results.csv
results*.jsonl
zz-run-*/
samples/zz-eval-*/

# Search indexes: built on each machine by global/tools/build-index.ts, never in Git
global/index/

# Lint configs of the samples: copied from global/lint/ by the tests
samples/*/.agents/lint/

# Cache of the Angular CLI (ng test, ng build)
.angular/

# Settings of one machine, such as the Node binaries the tests also run
*.local.txt

# Local secrets
.env
.env.*

# The system's
.DS_Store
