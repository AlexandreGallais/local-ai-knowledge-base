{
  "sources": [
    {
      "tool": "rust-book",
      "title": "The Rust Programming Language",
      "repository": "https://github.com/rust-lang/book.git",
      "ref": "main",
      "version": "2026-11",
      "license": "MIT OR Apache-2.0",
      "attribution": "Steve Klabnik, Carol Nichols, Chris Krycho and the Rust community",
      "paths": [
        "src/",
        "listings/"
      ],
      "docs": ["src"]
    },
    {
      "tool": "rust-reference",
      "title": "The Rust Reference",
      "repository": "https://github.com/rust-lang/reference.git",
      "ref": "master",
      "version": "2026-11",
      "license": "MIT OR Apache-2.0",
      "attribution": "The Rust Project Developers",
      "paths": ["src/"],
      "docs": ["src"]
    },
    {
      "tool": "rust-std",
      "title": "The Rust standard library: core, alloc and std, from their documentation comments",
      "repository": "https://github.com/rust-lang/rust.git",
      "ref": "1.100.0",
      "version": "1.100",
      "license": "MIT OR Apache-2.0",
      "attribution": "The Rust Project Developers",
      "paths": [
        "library/core/src/",
        "library/alloc/src/",
        "library/std/src/"
      ],
      "docs": [
        "library/core/src",
        "library/alloc/src",
        "library/std/src"
      ],
      "extract": "rustdoc"
    },
    {
      "tool": "cargo",
      "title": "The Cargo Book: manifests, workspaces, features, profiles, commands",
      "repository": "https://github.com/rust-lang/cargo.git",
      "ref": "0.101.0",
      "version": "1.100",
      "license": "MIT OR Apache-2.0",
      "attribution": "The Rust Project Developers",
      "paths": ["doc/book/src/"],
      "docs": ["doc/book/src"]
    },
    {
      "tool": "rust-by-example",
      "title": "Rust by Example",
      "repository": "https://github.com/rust-lang/rust-by-example.git",
      "ref": "master",
      "version": "2026-11",
      "license": "MIT OR Apache-2.0",
      "attribution": "The Rust Project Developers",
      "paths": ["src/"],
      "docs": ["src"]
    },
    {
      "tool": "tokio",
      "title": "Tokio: asynchronous Rust (the tutorial: spawning, shared state, channels, I/O, framing, async in depth, select, streams; topics: graceful shutdown, tracing, bridging with sync code)",
      "repository": "https://github.com/tokio-rs/website.git",
      "ref": "master",
      "version": "1",
      "license": "MIT",
      "attribution": "Carl Lerche and the Tokio website contributors",
      "paths": [
        "content/",
        "LICENSE"
      ],
      "docs": ["content"],
      "files": "\\.md$",
      "exclude": ["content/blog"]
    },
    {
      "tool": "serde",
      "title": "Serde: serializing and deserializing Rust data structures (derive, attributes, custom serialization, data formats)",
      "repository": "https://github.com/serde-rs/serde-rs.github.io.git",
      "ref": "master",
      "version": "1",
      "license": "CC-BY-SA-4.0",
      "attribution": "The Serde contributors",
      "paths": [
        "_src/",
        "LICENSE-CC-BY-SA"
      ],
      "docs": ["_src"],
      "files": "\\.md$"
    }
  ]
}
