{
  "sources": [
    {
      "tool": "csharp",
      "title": "C# language: guides, language reference and what is new",
      "repository": "https://github.com/dotnet/docs.git",
      "ref": "main",
      "version": "15",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the .NET docs contributors",
      "paths": [
        "docs/csharp/",
        "includes/"
      ],
      "docs": ["docs/csharp"],
      "exclude": ["docs/csharp/**/snippets"]
    },
    {
      "tool": "dotnet-core",
      "title": ".NET fundamentals and runtime guides",
      "repository": "https://github.com/dotnet/docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the .NET docs contributors",
      "paths": [
        "docs/core/",
        "includes/"
      ],
      "docs": ["docs/core"],
      "exclude": ["docs/core/**/snippets"]
    },
    {
      "tool": "dotnet-standard",
      "title": ".NET standard library guides",
      "repository": "https://github.com/dotnet/docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the .NET docs contributors",
      "paths": [
        "docs/standard/",
        "samples/snippets/csharp/",
        "includes/"
      ],
      "docs": ["docs/standard"],
      "exclude": ["docs/standard/**/snippets"]
    },
    {
      "tool": "aspnetcore",
      "title": "ASP.NET Core documentation",
      "repository": "https://github.com/dotnet/AspNetCore.Docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the ASP.NET Core docs contributors",
      "paths": ["aspnetcore/"],
      "docs": ["aspnetcore"],
      "exclude": [
        "aspnetcore/**/samples",
        "aspnetcore/**/samples_snapshot",
        "aspnetcore/**/snippets",
        "aspnetcore/**/wwwroot"
      ]
    },
    {
      "tool": "efcore",
      "title": "Entity Framework Core documentation",
      "repository": "https://github.com/dotnet/EntityFramework.Docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the Entity Framework docs contributors",
      "paths": [
        "entity-framework/",
        "samples/"
      ],
      "docs": ["entity-framework"]
    },
    {
      "tool": "dotnet-fundamentals",
      "title": ".NET fundamentals: dependency injection, configuration, logging, code analysis rules CA and IDE",
      "repository": "https://github.com/dotnet/docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the .NET documentation contributors",
      "paths": ["docs/fundamentals/"],
      "docs": ["docs/fundamentals"],
      "exclude": [
        "docs/fundamentals/**/snippets",
        "docs/fundamentals/**/media"
      ]
    },
    {
      "tool": "dotnet-architecture",
      "title": ".NET architecture guides: microservices, containers, cloud-native, modern web applications",
      "repository": "https://github.com/dotnet/docs.git",
      "ref": "main",
      "version": "11",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft and the .NET documentation contributors",
      "paths": ["docs/architecture/"],
      "docs": ["docs/architecture"],
      "exclude": ["docs/architecture/**/media"]
    },
    {
      "tool": "aspire",
      "title": ".NET Aspire: app host, integrations, deployment, observability",
      "repository": "https://github.com/dotnet/docs-aspire.git",
      "ref": "main",
      "version": "13",
      "license": "MIT",
      "attribution": "Microsoft and the .NET Aspire documentation contributors",
      "paths": ["docs/"],
      "docs": ["docs"],
      "exclude": [
        "docs/**/snippets",
        "docs/**/media"
      ]
    },
    {
      "tool": "aspnetcore-api",
      "title": "ASP.NET Core API reference: the XML documentation of the shared framework Microsoft.AspNetCore.App",
      "repository": "https://www.nuget.org/packages/Microsoft.AspNetCore.App.Ref/11.0.0",
      "archive": "https://api.nuget.org/v3-flatcontainer/microsoft.aspnetcore.app.ref/11.0.0/microsoft.aspnetcore.app.ref.11.0.0.nupkg",
      "ref": "11.0.0",
      "version": "11.0",
      "license": "MIT",
      "attribution": ".NET Foundation and Contributors",
      "paths": ["ref/net11.0/"],
      "docs": ["ref/net11.0"],
      "licenseTexts": { "LICENSE.txt": "https://raw.githubusercontent.com/dotnet/aspnetcore/main/LICENSE.txt" }
    },
    {
      "tool": "efcore-api",
      "title": "Entity Framework Core API reference: the XML documentation of Microsoft.EntityFrameworkCore",
      "repository": "https://www.nuget.org/packages/Microsoft.EntityFrameworkCore/11.0.0",
      "archive": "https://api.nuget.org/v3-flatcontainer/microsoft.entityframeworkcore/11.0.0/microsoft.entityframeworkcore.11.0.0.nupkg",
      "ref": "11.0.0",
      "version": "11.0",
      "license": "MIT",
      "attribution": ".NET Foundation and Contributors",
      "paths": ["lib/net11.0/"],
      "docs": ["lib/net11.0"],
      "licenseTexts": { "LICENSE.txt": "https://raw.githubusercontent.com/dotnet/efcore/main/LICENSE.txt" }
    },
    {
      "tool": "efcore-relational-api",
      "title": "Entity Framework Core relational API reference: the XML documentation of Microsoft.EntityFrameworkCore.Relational",
      "repository": "https://www.nuget.org/packages/Microsoft.EntityFrameworkCore.Relational/11.0.0",
      "archive": "https://api.nuget.org/v3-flatcontainer/microsoft.entityframeworkcore.relational/11.0.0/microsoft.entityframeworkcore.relational.11.0.0.nupkg",
      "ref": "11.0.0",
      "version": "11.0",
      "license": "MIT",
      "attribution": ".NET Foundation and Contributors",
      "paths": ["lib/net11.0/"],
      "docs": ["lib/net11.0"],
      "licenseTexts": { "LICENSE.txt": "https://raw.githubusercontent.com/dotnet/efcore/main/LICENSE.txt" }
    },
    {
      "tool": "dotnet-desktop",
      "title": "Windows desktop apps in .NET: WPF (XAML, controls, layout, data binding, styles and templates, commands, graphics and animation) and Windows Forms",
      "repository": "https://github.com/dotnet/docs-desktop.git",
      "ref": "main",
      "version": "main",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft Corporation and the docs-desktop contributors",
      "paths": [
        "dotnet-desktop-guide/**/*.md",
        "LICENSE",
        "LICENSE-CODE"
      ],
      "docs": ["dotnet-desktop-guide"],
      "files": "\\.md$"
    },
    {
      "tool": "maui",
      "title": ".NET MAUI: cross-platform apps for Windows, Android, iOS and macOS (XAML, controls, layouts, data binding, MVVM, platform integration, deployment)",
      "repository": "https://github.com/dotnet/docs-maui.git",
      "ref": "main",
      "version": "main",
      "license": "CC-BY-4.0",
      "attribution": "Microsoft Corporation and the docs-maui contributors",
      "paths": [
        "docs/**/*.md",
        "LICENSE",
        "LICENSE-CODE"
      ],
      "docs": ["docs"],
      "files": "\\.md$"
    },
    {
      "tool": "xunit",
      "title": "xUnit.net: writing and running tests in .NET (facts, theories, fixtures, shared context, v3 and Microsoft Testing Platform, analyzers)",
      "repository": "https://github.com/xunit/xunit.net.git",
      "ref": "main",
      "version": "v3",
      "license": "Apache-2.0",
      "attribution": ".NET Foundation and the xUnit.net contributors",
      "paths": [
        "site/**/*.md",
        "LICENSE.txt"
      ],
      "docs": ["site"],
      "files": "\\.md$"
    },
    {
      "tool": "nunit",
      "title": "NUnit: writing tests in .NET (attributes, assertions and constraints, the runners, the analyzers)",
      "repository": "https://github.com/nunit/docs.git",
      "ref": "master",
      "version": "4",
      "license": "MIT",
      "attribution": "NUnit.org",
      "paths": [
        "docs/**/*.md",
        "LICENSE.md"
      ],
      "docs": ["docs"],
      "files": "\\.md$"
    },
    {
      "tool": "polly",
      "title": "Polly 8: resilience in .NET (retry, circuit breaker, timeout, fallback, hedging, rate limiter, resilience pipelines)",
      "repository": "https://github.com/App-vNext/Polly.git",
      "ref": "8.9.1",
      "version": "8.9",
      "license": "BSD-3-Clause",
      "attribution": "App vNext and the Polly contributors",
      "paths": [
        "docs/",
        "LICENSE"
      ],
      "docs": ["docs"],
      "files": "\\.md$"
    }
  ]
}
