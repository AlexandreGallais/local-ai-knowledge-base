{
  "instructions": [
    ".agents/rules.md",
    ".agents/mcp/*/rules.md"
  ],
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "biome": {
      "disabled": true
    },
    "oxfmt": {
      "disabled": true
    },
    "eslint-format": {
      "command": [
        "npx",
        "--no",
        "--",
        "eslint",
        "--config",
        "eslint.format.config.mjs",
        "--fix",
        "$FILE"
      ],
      "extensions": [
        ".ts",
        ".mts",
        ".html",
        ".json"
      ]
    },
    "stylelint-format": {
      "command": [
        "npx",
        "--no",
        "--",
        "stylelint",
        "--config",
        "stylelint.format.config.mjs",
        "--fix",
        "--allow-empty-input",
        "$FILE"
      ],
      "extensions": [
        ".css",
        ".scss"
      ]
    }
  },
  "mcp": {
    "servers": {
      "js-official-docs": {
        "type": "local",
        "command": [
          "node",
          ".agents/mcp/js-official-docs/server.ts"
        ],
        "codemode": false
      },
      "parse": {
        "type": "local",
        "command": [
          "node",
          ".agents/mcp/parse/server.ts"
        ],
        "codemode": false
      }
    }
  }
}
