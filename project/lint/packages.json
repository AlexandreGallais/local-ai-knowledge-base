{
  "scripts": {
    "format": "eslint --config eslint.format.config.mjs --fix . && stylelint --config stylelint.format.config.mjs --fix --allow-empty-input \"**/*.{css,scss}\"",
    "lint": "eslint --format ./lint/formatter.cjs . && stylelint --formatter unix --allow-empty-input \"**/*.{css,scss}\"",
    "check": "npm run format && npm run lint"
  },
  "always": {
    "@double-great/stylelint-a11y": "3.8.3",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "6.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-unicorn": "79.0.0",
    "postcss-scss": "4.0.9",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "angular": {
    "@ngrx/eslint-plugin": "22.0.1",
    "angular-eslint": "22.6.0",
    "eslint-plugin-rxjs-x": "1.0.6"
  }
}
