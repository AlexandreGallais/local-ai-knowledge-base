  "agents": {
    "architecture-review": {
      "description": "Reviews the architecture of a .NET and Angular application: structure, API contract, real-time design, library choices. Reads only, changes no file.",
      "mode": "subagent",
      "system": "Load the skill `architecture-review` with the skill tool. Follow it exactly. Follow the rules of AGENTS.md. Answer in the language of the user's question.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "code-review": {
      "description": "Reviews a code change in C#, TypeScript or Angular against the checklist of the base. Reads only, changes no file.",
      "mode": "subagent",
      "system": "Load the skill `code-review` with the skill tool. Follow it exactly. Follow the rules of AGENTS.md. Answer in the language of the user's question.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explain-equipment": {
      "description": "Explains a piece of ship equipment: its real working first, then its simulation model and its property names. Reads only, changes no file.",
      "mode": "subagent",
      "system": "Load the skill `explain-equipment` with the skill tool. Follow it exactly. Follow the rules of AGENTS.md. Answer in the language of the user's question.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
